# ── Supabase (Project Settings → API Keys) ────────────────────────────────
# Public: safe in the browser, protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
# Used for: the public inquiry form and the (disabled) event dispatcher.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# ── Public form protection ────────────────────────────────────────────────
# Random string (32+ chars). Signs the form timing token and salts IP hashes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=change-me-to-a-long-random-string

# ── Phase 2: n8n automations (docs/n8n-setup.md) ──────────────────────────
# Events are always recorded in the database outbox. They are sent to n8n
# only when EVENTS_DISPATCH_ENABLED=true and the n8n settings are present.
EVENTS_DISPATCH_ENABLED=false
# Base URL of your n8n instance (https, or http://localhost:5678 for local).
N8N_BASE_URL=
# Sent to n8n as "Authorization: Bearer …" (n8n Header Auth credential).
N8N_WEBHOOK_SECRET=
# n8n sends this back to /api/automations/callback as "Authorization: Bearer …".
AUTOMATION_CALLBACK_SECRET=
# Optional: "test" posts to /webhook-test/ while you listen in the n8n editor.
N8N_WEBHOOK_MODE=
# Bearer token for /api/events/dispatch (scheduler / workflow C / Vercel Cron).
CRON_SECRET=

# ── Optional: public demo account (README → "Public demo account") ───────
# Shown on /login with a "Use the demo account" button. These values are
# meant to be public; the database limits what this login can change once its
# profile has is_demo = true. Leave empty to hide the demo box.
DEMO_EMAIL=
DEMO_PASSWORD=
